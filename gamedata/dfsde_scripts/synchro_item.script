-- слот, в который спавним предметы с анимацией (имхо, бинокль - самое оптимальное, с болтом не получилось)
local hud_item_slot = 12 --13 -- номер --Simp: используем слот биодетектора, которого тут нет
local hud_item_slot_default = "wpn_binoc" -- дефолтный предмет
local SLOT_RESTORE
-- вспомогательные переменные, не трогать
local use_timer = 0
local sounds_tbl = { }
local hidden_weapon = false

function on_spawn()
	-- инициализируем звуковые объекты
	for k,v in pairs(available_sections) do
		local snd = v[2]
		if sounds_tbl[snd] == nil then
			sounds_tbl[snd] = sound_object(snd)
		end
	end
	
	level.only_allow_movekeys(false)
end


local snd_in_use = false
		
local function play_use_sound(sect)
	local snd = get_string( sect, "use_sound" )
	if snd then
		if snd_in_use then
			snd_in_use:stop()
		end
		snd_in_use = sound_object( snd )
		snd_in_use:play( db.actor, 0, sound_object.s2d )
	end
end

local BOLT_TIMEOUT_MS = 5000  -- если за это время предмет не появился, продолжаем как есть

function on_use(obj) --вызывается при юзе предмета
	if game_options.HaveEat == false then
		als_inv_sounds.use_snd(obj)
		return
	elseif game_options.HaveEat ~= true then
		return
	end

	local section = obj:section()
	if available_sections[section] == nil then
		return
	end

	play_use_sound(section)

	-- в экзе используются другие худы/тайминги
	local armor = db.actor:item_in_slot(6)
	local exo = armor ~= nil and (armor:section() == "exo_outfit" or armor:section() == "outfit_exo_m1" or armor:section() == "outfit_exo_m2")
	local section_params = (exo and available_sections_exo or available_sections)[section]
	if section_params == nil then
		section_params = available_sections[section]
	end

	local hud_obj_section = section_params[1]
	local sound = section_params[2]
	local time = section_params[3]
	local precond = section_params[4]
	local use_obj_section = section_params[5]
	local using_item_timer = 0

	-- проверка занятости рук
	if use_timer > time_global() then
		tip("Невозможно использовать предмет: у вас заняты руки")
		spawn(section) -- возвращаем предмет обратно в рюкзак
		return
	end

	-- проверка дополнительных условий использования
	if precond and precond() == false then
		spawn(section) -- возвращаем предмет обратно в рюкзак
		return
	end

	-- закрываем инвентарь, если он открыт
	local inventory_wnd = level.main_input_receiver()
	local inv_wpn = false
	if inventory_wnd then
		-- оружие/предмет был убран при открытии инвентаря (см. inventory.script): при закрытии инвентаря его возвращать не нужно,
		-- он вернётся в руки сам в конце использования предмета (SLOT_RESTORE)
		inv_wpn = (inventory.weapon_hidden == true) and not has_alife_info("actor_zone_no_weapon")
		inventory.suppress_restore = inv_wpn
		level.start_stop_menu(inventory_wnd, true)
	end

	level.only_allow_movekeys(true)
	local sound_obj = sounds_tbl[sound]

	-- пока ждём освобождения рук, повторное использование заблокировано
	-- настоящий отсчёт длительности анимации стартует в wait_stop
	use_timer = time_global() + time + 5000

	local bolt_used = false
	local bolt_deadline = 0

	-- функции ожидания, пока предмет съедается
	local eating_start = function()
		if using_item_timer < time_global() then
			return true
		end
	end
	local eating_end = function()
		db.actor:eat(db.actor:object(use_obj_section))
		if hidden_weapon == true then
			hidden_weapon = false
			db.actor:restore_weapon()
		end
		db.actor:activate_slot(SLOT_RESTORE)
	end

	-- функции эффекта
	local effect_start = function()
		if hud_obj_section ~= nil then
			if db.actor:active_slot() ~= hud_item_slot then
				db.actor:activate_slot(hud_item_slot)
			end
		end

		if use_timer < time_global() then
			return true
		end
	end
	local effect_stop = function()
		-- останавливаем звук
		if sound_obj then
			if sound_obj:playing() then
				sound_obj:stop()
			end
		end

		-- убираем предмет из худа и прячем оружие
		if hud_obj_section ~= nil then
			destroy_actor_item(hud_obj_section)
			db.actor:hide_weapon()
		else
			db.actor:restore_weapon()
		end

		level.only_allow_movekeys(false)

		using_item_timer = time_global() + 10
		spawn(use_obj_section)
		level.add_call(eating_start, eating_end)
	end

	-- ждём освобождения рук
	local wait_start = function()
		if bolt_used then
			local now = time_global()
			if now > bolt_deadline then
				return true
			end

			if db.actor:item_in_slot(hud_item_slot) and db.actor:active_slot() ~= hud_item_slot then
				db.actor:activate_slot(hud_item_slot)
			end
			local a = db.actor:active_item()
			if a and a:section() == hud_obj_section then
				return true
			end
			return
		end

		if not db.actor:active_item() then
			return true
		end
	end

	local wait_stop = function()
		-- настоящий отсчёт анимации: с момента, когда предмет реально появился
		use_timer = time_global() + time

		if sound_obj then
			sound_obj:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
		end

		if hud_obj_section ~= nil then
			if not bolt_used then
				spawn(hud_obj_section)
				db.actor:restore_weapon()
			end
		else
			db.actor:hide_weapon()
		end

		level.add_call(effect_start, effect_stop)
	end

	SLOT_RESTORE = db.actor:active_slot()
	if inv_wpn then
	    -- оружие вернётся в свой слот в конце использования
		SLOT_RESTORE = inventory.weapon_slot 
	end
	local itm = db.actor:active_item()

	if hud_obj_section ~= nil and itm and itm:section() == "bolt" then
		-- болт не прячем через hide_weapon, спавним предмет и переключаем слот
		bolt_used = true
		bolt_deadline = time_global() + BOLT_TIMEOUT_MS
		hidden_weapon = true
		spawn(hud_obj_section)
		db.actor:activate_slot(hud_item_slot)
	else
		if itm then
			db.actor:hide_weapon()
			hidden_weapon = true
		elseif inv_wpn then
			hidden_weapon = true -- чтобы в eating_end перед возвратом оружия снялась блокировка
		end
		db.actor:activate_slot(hud_item_slot)
	end

	level.add_call(wait_start, wait_stop)
end

-- спавн предмета в рюкзак герою
function spawn(section)
	return alife():create(section, vector(), 0, 0, db.actor:id())
end

-- удалить предмет из рюкзака героя
function destroy_actor_item(section)
    local obj = db.actor:object(section)
    if obj then
        local sobj = alife():object(obj:id())
        if sobj then
            alife():release(sobj)
        end
    end
end

-- выдать сообщение на 5 секунд
function tip(text)
	db.actor:give_game_news(text, "ui\\ui_iconsTotal", Frect():set(83,470,83,47), 0, 5000)
end


function release_trash() --вызывается на первом апдейте
	local item_in_slot = db.actor:item_in_slot(hud_item_slot)
	if item_in_slot then
		local release_item = item_in_slot:section()
		alife():release(alife():object(db.actor:object(release_item):id()))
	end
end

